{% extends 'base.html.twig' %}

{% block title %}Inscription index{% endblock %}

{% block body %}
<div class="container-fluid">

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Basic Datatable</h5>
            <div class="table-responsive">
                <table id="zero_config" class="table table-striped table-bordered">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nom_enfant</th>
                        <th>Prenom_enfant</th>
                        <th>Nom_parent</th>
                        <th>Telephone_parent</th>
                        <th>Date_naissance</th>


                        <th>actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for inscription in inscriptions %}
                        <tr>
                            <td>{{ inscription.id }}</td>
                            <td>{{ inscription.nomEnfant }}</td>
                            <td>{{ inscription.prenomEnfant }}</td>
                            <td>{{ inscription.nomParent }}</td>
                            <td>{{ inscription.telephoneParent }}</td>
                            <td>{{ inscription.dateNaissance ? inscription.dateNaissance|date('Y-m-d') : '' }}</td>

                            <td>
                                <a href="{{ path('inscription_show', {'id': inscription.id}) }}"><i class=" fas fa-arrows-alt"></i></a>
                                <a href="{{ path('inscription_edit', {'id': inscription.id}) }}"><i class=" fas fa-edit"></i></a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7">no records found</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                <a class="btn btn-success float-right" href="{{ path('inscription_new') }}">Ajouter Participation</a>
                {% endblock %}
