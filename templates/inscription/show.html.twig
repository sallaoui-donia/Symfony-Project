{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <h1>Inscription</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ inscription.id }}</td>
            </tr>
            <tr>
                <th>Nom_enfant</th>
                <td>{{ inscription.nomEnfant }}</td>
            </tr>
            <tr>
                <th>Prenom_enfant</th>
                <td>{{ inscription.prenomEnfant }}</td>
            </tr>
            <tr>
                <th>Nom_parent</th>
                <td>{{ inscription.nomParent }}</td>
            </tr>
            <tr>
                <th>Telephone_parent</th>
                <td>{{ inscription.telephoneParent }}</td>
            </tr>
            <tr>
                <th>Date_naissance</th>
                <td>{{ inscription.dateNaissance ? inscription.dateNaissance|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('inscription_index') }}">back to list</a>

    <a class="btn btn-primary" href="{{ path('inscription_edit', {'id': inscription.id}) }}">edit</a>

    {{ include('inscription/_delete_form.html.twig') }}
{% endblock %}
