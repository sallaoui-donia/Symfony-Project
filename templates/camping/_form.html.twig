
<div class="container-fluid">

    <div class="card">
        <div  class="card-body wizard-content">


            <div  class="m-t-40">
                {{ form_start(form) }}

                <h3>Gérer votre camping</h3>
                <div class="form-wrapper">
                    <label for="">Camping :</label>
                </div>
                    {{ form_widget(form.nom_c) }}

                <div class="form-group">
                    <div class="form-wrapper">
                        <label for="">Date debut     :</label>
                    </div>
                        <!--input type="text" class="form-control"-->
                        {{ form_widget(form.date_debut) }}

                    <div class="form-wrapper">
                        <label for="">Date fin       </label>
                    </div>
                        {{ form_widget(form.date_fin) }}


                <div class="form-wrapper">
                    <label for="">Programme de rando</label>
                </div>
                    {{ form_widget(form.program) }}

                <div class="form-wrapper">
                    <label for="">Destination       : </label>
                </div>
                    {{ form_widget(form.destination) }}
                </div>

                <div class="form-wrapper">
                    <label for="">Nombre de places disponible</label>
                </div>
                    {{ form_widget(form.nbrplaces) }}

                <div class="form-wrapper">
                    <label for="">Nombre de bus</label>
                </div>
                    {{ form_widget(form.nbrbus) }}


                <div class="form-wrapper">
                    <label for="">Prix </label>
                </div>
                    {{ form_widget(form.prix_c) }}

                {{ form_widget(form) }}


        </div>

        <div class="border-top">
                                    <div class="card-body">
    <button class="btn btn-success">{{ button_label|default('Save') }}</button>

                                    </div>
                                </div>
                            </div>
                    </div>
{{ form_end(form) }}
