{% extends 'base.html.twig' %}

{% block title %}Camping{% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- ============================================================== -->
    <!-- Start Page Content -->
    <!-- ============================================================== -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title m-b-0">{{ camping.nomC }}</h5>
                </div>
                <table class="table">
                    <thead>
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ camping.id }}</td>
            </tr>

            <tr>
                <th>Program</th>
                <td>{{ camping.program }}</td>
            </tr>
            <tr>
                <th>Date_fin</th>
                <td>{{ camping.dateFin ? camping.dateFin|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date_debut</th>
                <td>{{ camping.dateDebut ? camping.dateDebut|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Destination</th>
                <td>{{ camping.destination }}</td>
            </tr>
            <tr>
                <th>Nbrplaces</th>
                <td>{{ camping.nbrplaces }}</td>
            </tr>
            <tr>
                <th>Nbrbus</th>
                <td>{{ camping.nbrbus }}</td>
            </tr>
            <tr>
                <th>Prix_c</th>
                <td>{{ camping.prixC }}</td>
            </tr>
            <tr>
                <th>Les inscriptions </th>


                <td>{% for inscrip in camping.inscriptions %}

                        {{inscrip.nomEnfant}}
                        {{inscrip.prenomEnfant}}
                        {{inscrip.nomParent}}
                        {{inscrip.telephoneParent}}




                    {% endfor %}</td>

            </tr>
        </tbody>
    </table>

    <a href="{{ path('camping_index') }}">back to list</a>

    <a class="btn btn-info" href="{{ path('camping_edit', {'id': camping.id}) }}">edit</a>

    {{ include('camping/_delete_form.html.twig') }}
   </div>
{% endblock %}
