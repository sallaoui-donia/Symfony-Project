{% extends 'base.html.twig' %}

{% block title %}Formation index{% endblock %}

{% block body %}

    <div class="container-fluid">

    <div class="card" >
    <div class="card-body">
    <h5 class="card-title">Basic Datatable</h5>
    <div class="table-responsive">
    <table id="zero_config" class="table table-striped table-bordered">
        <thead>
        <tr>
            <th>Id</th>
            <th>Nom_f</th>
            <th>Niveau</th>
            <th>Objectif</th>
            <th>Date_debut</th>
            <th>Date_fin</th>
            <th>Prix_f</th>
            <th>actions</th>
        </tr>
        </thead>
        <tbody>
        {% for formation in formations %}
            <tr>
                <td>{{ formation.id }}</td>
                <td>{{ formation.nomF }}</td>
                <td>{{ formation.niveau }}</td>
                <td>{{ formation.objectif }}</td>
                <td>{{ formation.dateDebut ? formation.dateDebut|date('Y-m-d') : '' }}</td>
                <td>{{ formation.dateFin ? formation.dateFin|date('Y-m-d') : '' }}</td>
                <td>{{ formation.prixF }}</td>
                <td>
                    <a class="btn btn-primary" href="{{ path('formation_aff', {'id': formation.id}) }}">show</a>
                    {% if is_granted('ROLE_ADMIN') %}
                    <a class="btn btn-primary" href="{{ path('formation_edit', {'id': formation.id}) }}"><i class=" fas fa-edit"></i></a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if is_granted('ROLE_EDITOR') %}
    <a href="{{ path('formation_new') }}">Create new</a>
    {% endif %}
{% endblock %}