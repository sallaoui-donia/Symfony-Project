{% extends 'base.html.twig' %}

{% block title %}Formation index{% endblock %}

{% block body %}



<div class="container-fluid">

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Basic Datatable</h5>
            <div class="table-responsive">
                <table id="zero_config" class="table table-striped table-bordered">
            <tr>
                <th>Id</th>
                <th>Nom_f</th>
                <th>Niveau</th>
                <th>Objectif</th>
                <th>Date_debut</th>
                <th>Date_fin</th>
                <th>Prix_f</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for formation in formations %}
            <tr>
                <td>{{ formation.id }}</td>
                <td>{{ formation.nomF }}</td>
                <td>{{ formation.niveau }}</td>
                <td>{{ formation.objectif }}</td>
                <td>{{ formation.dateDebut ? formation.dateDebut|date('Y-m-d') : '' }}</td>
                <td>{{ formation.dateFin ? formation.dateFin|date('Y-m-d') : '' }}</td>
                <td>{{ formation.prixF }}</td>
                <td>
                    <a href="{{ path('formation_show', {'id': formation.id}) }}"><i class=" fas fa-arrows-alt"></i></a>
                    <a href="{{ path('formation_edit', {'id': formation.id}) }}"><i class=" fas fa-edit"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-success float-right"  href="{{ path('formation_new') }}">Ajouter Formation</a>
{% endblock %}
