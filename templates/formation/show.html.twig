{% extends 'base.html.twig' %}

{% block title %}Formation{% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- ============================================================== -->
    <!-- Start Page Content -->
    <!-- ============================================================== -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title m-b-0">{{ formation.nomF }}</h5>
                </div>
                <table class="table">
                    <thead>>
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ formation.id }}</td>
            </tr>

            <tr>
                <th>Niveau</th>
                <td>{{ formation.niveau }}</td>
            </tr>
            <tr>
                <th>Objectif</th>
                <td>{{ formation.objectif }}</td>
            </tr>
            <tr>
                <th>Date_debut</th>
                <td>{{ formation.dateDebut ? formation.dateDebut|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date_fin</th>
                <td>{{ formation.dateFin ? formation.dateFin|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Prix_f</th>
                <td>{{ formation.prixF }}</td>
            </tr>
            <tr>
                <th>Les inscriptions </th>


                <td>{% for inscrip in camping.inscriptions %}

                        {{inscrip.nomEnfant}}
                        {{inscrip.prenomEnfant}}
                        {{inscrip.nomParent}}
                        {{inscrip.telephoneParent}}




                    {% endfor %}</td>

            </tr>
        </tbody>
    </table>

    <a href="{{ path('formation_index') }}">back to list</a>

    <a class="btn btn-info" href="{{ path('formation_edit', {'id': formation.id}) }}">edit</a>

    {{ include('formation/_delete_form.html.twig') }}
{% endblock %}
