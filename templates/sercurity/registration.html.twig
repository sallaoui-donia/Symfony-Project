
{% block body %}


    <h2 class="form-title">s'inscrire</h2>


    {{ form_start(form) }}
    {{ form_row(form.email, { 'attr': { 'placeholder': 'Adresse email...' } } ) }}
    {{ form_row(form.username, { 'label':'Nom d\'utilisateur', 'attr': {'placeholder':'Nom d\'utilisateur...' } }) }}
    {{ form_row(form.password, { 'label':'Mot de passe', 'attr': {'placeholder':'Mot de passe...' } }) }}
    {{ form_row(form.confirm_password, { 'label':'Répétez votre mot de passe', 'attr':{'placeholder':'Répétez votre mot de passe...' } }) }}
    {{ form_row(form.roles) }}
    <button type="submit" class="btn btn-success">Inscription</button> {{ form_end(form) }}
    <figure><img src="../../system/images/etud1.png" alt="sing up image"></figure>{% endblock %}