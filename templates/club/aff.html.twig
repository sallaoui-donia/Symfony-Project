        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title m-b-0"{{ club.nomC }}</h5>
                </div>
                <table class="table">
                    <thead>
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ club.id }}</td>
        </tr>

        <tr>
            <th>Activite_c</th>
            <td>{{ club.activiteC }}</td>
        </tr>
        <tr>
            <th>Adresse_c</th>
            <td>{{ club.adresseC }}</td>
        </tr>
        <tr>
            <th>Prix_c</th>
            <td>{{ club.prixC }}</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('club_affich') }}">back to list</a>

{% endblock %}
