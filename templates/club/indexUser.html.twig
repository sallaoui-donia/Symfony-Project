{% extends 'base.html.twig' %}

{% block title %}Club index{% endblock %}

{% block body %}


    <div class="container-fluid">

    <div class="card">
    <div class="card-body">
    <h5 class="card-title">Basic Datatable</h5>
    <div class="table-responsive">
    <table id="zero_config" class="table table-striped table-bordered">
        <thead>
        <tr>
            <th>Id</th>
            <th>Nom Club</th>
            <th>Activite </th>
            <th>Adresse</th>
            <th>Activité</th>

            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        <tr>
            {% for club in clubs %}
        <tr>
            <td>{{ club.id }}</td>
            <td>{{ club.nomC }}</td>
            <td>{{ club.activiteC }}</td>
            <td>{{ club.adresseC }}</td>
            <td>{{ club.prixC }}</td>

            <td>
                <a href="{{ path('club_aff', {'id': club.id}) }}"><i class=" fas fa-arrows-alt"></i></a>
                {% if is_granted('ROLE_EDITOR') %}
                    <a class="btn btn-primary" href="{{ path('club_edit', {'id': club.id}) }}"><i class=" fas fa-edit"></i></a>
                {% endif %}

            </td>
        </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if is_granted('ROLE_EDITOR') %}

    <a class="btn btn-success float-right" href="{{ path('club_new') }}">Ajouter Club</a>

    {% endif %}



{% endblock %}