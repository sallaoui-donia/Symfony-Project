
<div class="container-fluid">

    <div class="card">
        <div  class="card-body wizard-content">


            <div  class="m-t-40">
                {{ form_start(form) }}

                <h3>Gérer votre Randonnée</h3>
                <div class="form-wrapper">
                    <label for="">Randonnée :</label>
                </div>
                {{ form_widget(form.nom_r) }}

                <div class="form-group">
                    <div class="form-wrapper">
                        <label for="">Programme Randonnée</label>
                    </div>
                    <!--input type="text" class="form-control"-->
                    {{ form_widget(form.program) }}

                    <div class="form-wrapper">
                        <label for="">Date de Randonnée       </label>
                    </div>
                    {{ form_widget(form.date_r) }}


                    <div class="form-wrapper">
                        <label for="">Prix :</label>
                    </div>
                    {{ form_widget(form.prix_r) }}

                    <div class="form-wrapper">
                        <label for="">Destination : </label>
                    </div>
                    {{ form_widget(form.destination) }}

                    {{ form_widget(form) }}


                </div>

                <div class="border-top">
                    <div class="card-body">
                        <button class="btn btn-success">{{ button_label|default('Save') }}</button>

                    </div>
                </div>
            </div>
        </div>
{{ form_end(form) }}