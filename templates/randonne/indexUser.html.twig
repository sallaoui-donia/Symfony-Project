{% extends 'base.html.twig' %}

{% block title %}Randonne index{% endblock %}

{% block body %}

<div class="container-fluid">

    <div class="card" >
        <div class="card-body">
            <h5 class="card-title">Basic Datatable</h5>
            <div class="table-responsive">
                <table id="zero_config" class="table table-striped table-bordered">
    <thead>
    <tr>
        <th>Id</th>
        <th>Nom_r</th>
        <th>Program</th>
        <th>Date_r</th>
        <th>Prix_r</th>
        <th>Destination</th>
        <th>actions</th>
    </tr>
    </thead>
    <tbody>
    {% for randonne in randonnes %}
    <tr>
        <td>{{ randonne.id }}</td>
        <td>{{ randonne.nomR }}</td>
        <td>{{ randonne.program }}</td>
        <td>{{ randonne.dateR ? randonne.dateR|date('Y-m-d') : '' }}</td>
        <td>{{ randonne.prixR }}</td>
        <td>{{ randonne.destination }}</td>
        <td>
            <a class="btn btn-primary" href="{{ path('randonne_aff', {'id': randonne.id}) }}">Show</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a class="btn btn-primary" href="{{ path('randonne_edit', {'id': randonne.id}) }}"><i class=" fas fa-edit"></i></a>
            {% endif %}


        </td>
    </tr>
    {% else %}
        <tr>
            <td colspan="7">no records found</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
    {% if is_granted('ROLE_EDITOR') %}
<a href="{{ path('randonne_new') }}">Create new</a>
    {% endif %}
{% endblock %}
