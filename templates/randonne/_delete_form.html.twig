<form method="post" action="{{ path('randonne_delete', {'id': randonne.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_method" value="DELETE">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ randonne.id) }}">
    <button class="btn btn-danger">Delete</button>
</form>
